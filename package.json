{
  "name": "fex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fast, private, offline-ready currency converter.",
  "engines": { "node": ">=22.22.2 <23 || >=24.15.0" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons": "node scripts/icons.mjs",
    "build": "pnpm run icons && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:browser": "playwright test --grep-invert @performance",
    "test:performance": "playwright test tests/browser/performance.spec.js --project=chromium --workers=1",
    "test:live": "node scripts/smoke-live.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run build && pnpm run check:size && pnpm run test:browser && pnpm run test:performance"
  },
  "dependencies": { "decimal.js-light": "2.5.1" },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  }
}
